{
  "name": "alongline-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs && node tests/construction-browser.mjs",
    "test:train": "node tests/train-browser.mjs",
    "test:travel": "node tests/travel-browser.mjs",
    "test:growth": "node tests/growth-browser.mjs",
    "test:dispatch": "node tests/dispatch-browser.mjs",
    "test:business": "node tests/business-browser.mjs",
    "test:passengers": "node tests/passenger-browser.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e && npm run test:train && npm run test:passengers && npm run test:business && npm run test:dispatch && npm run test:growth && npm run test:travel"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/three": "0.180.0",
    "playwright-core": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
